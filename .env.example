# ==============================================================================
# QuizLive Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
# Fill in your local database password and customize any settings.
# For production (Render, Railway, Docker, AWS), configure these variables in the platform dashboard.

# ------------------------------------------------------------------------------
# 1. Server Configuration
# ------------------------------------------------------------------------------
PORT=8080
CONTEXT_PATH=/quizlive

# ------------------------------------------------------------------------------
# 2. Database Configuration (Option A: Disaggregated parameters)
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=quizlive
DB_USER=root
DB_PASSWORD=your_database_password_here
DB_SSL=false

# ------------------------------------------------------------------------------
# 3. Database Configuration (Option B: Single URL - overrides Option A if set)
# ------------------------------------------------------------------------------
# DATABASE_URL=mysql://user:password@host:3306/dbname
# DB_URL=jdbc:mysql://localhost:3306/quizlive?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&createDatabaseIfNotExist=true

# ------------------------------------------------------------------------------
# 4. Connection Pool (HikariCP)
# ------------------------------------------------------------------------------
HIKARI_MAX_POOL_SIZE=10
HIKARI_MIN_IDLE=2
HIKARI_IDLE_TIMEOUT=30000
HIKARI_CONNECTION_TIMEOUT=20000
HIKARI_MAX_LIFETIME=1800000

# ------------------------------------------------------------------------------
# 5. Database Schema & Seed Data Auto-Initialization
# ------------------------------------------------------------------------------
DB_AUTO_INIT=true
